NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://cinemate:cinemate@mysql:3306/cinemate
DATABASE_POOL_SIZE=10
DRIZZLE_MIGRATIONS_DIR=/app/drizzle
APP_BASE_URL=http://localhost:3000

OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=rustfsadmin
OBJECT_STORAGE_SECRET_KEY=rustfsadmin
OBJECT_STORAGE_BUCKET=cinemate-images

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=cinemate
MYSQL_USER=cinemate
MYSQL_PASSWORD=cinemate

JWT_ACCESS_SECRET=change-me-user-access-secret
JWT_REFRESH_SECRET=change-me-user-refresh-secret
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cinemate.local
ADMIN_PASSWORD=Admin@123456
ADMIN_SEED_FORCE_UPDATE=false

XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_INVOICE_DURATION_SECONDS=86400
FRONTEND_SUCCESS_URL=http://localhost:5173/payment/success
FRONTEND_FAILURE_URL=http://localhost:5173/payment/failed
