meta {
  name: Create FNB Order
  type: http
  seq: 1
}

post {
  url: {{apiUrl}}/fnb-orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "showtimeId": {{showtimeId}},
    "items": [
      {
        "snackId": {{snackId}},
        "quantity": 2
      }
    ]
  }
}
