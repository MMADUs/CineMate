meta {
  name: Create FNB Payment
  type: http
  seq: 2
}

post {
  url: {{apiUrl}}/payments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "fnbOrderId": "{{fnbOrderId}}",
    "paymentMethod": "XENDIT_INVOICE"
  }
}
